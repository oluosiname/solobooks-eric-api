    </S>\\n          <Vorsatz>\\n            <Unterfallart>10</Unterfallart>\\n            <Vorgang>01</Vorgang>\\n            <StNr>1096081508152</StNr>\\n            <Zeitraum>2025</Zeitraum>\\n            <AbsName>Max Mustermann</AbsName>\\n            <AbsStr>Musterstr. 1</AbsStr>\\n            <AbsPlz>10115</AbsPlz>\\n            <AbsOrt>Berlin</AbsOrt>\\n            <Copyright>Solobooks</Copyright>\\n            <OrdNrArt>S</OrdNrArt>\\n            <Rueckuebermittlung>\\n              <Bescheid>1</Bescheid>\\n              <ArtRueckuebermittlung>INTERNET</ArtRueckuebermittlung>\\n            </Rueckuebermittlung>\\n          </Vorsatz>\\n        </E10>\\n      </Nutzdaten>\\n    </Nutzdatenblock>\\n  </DatenTeil>\\n</Elster>\\n\",\n  \"datenartversion\": \"ESt_2025\"\n}"
        },
        "description": "Same document, datenartversion pinned. Identical result -\nwhich is the point: detection agrees with the explicit value."
      }
    },
